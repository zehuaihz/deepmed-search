# MinerU Docker 镜像（CPU 版本，无需 GPU）
# 参考：https://opendatalab.github.io/MinerU/zh/quick_start/docker_deployment/

# 使用国内 Docker Hub 镜像（daocloud）
FROM docker.m.daocloud.io/library/python:3.10-slim

WORKDIR /app

# 配置国内 APT 镜像源（阿里云）
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    fonts-noto-core \
    fonts-noto-cjk \
    fontconfig \
    libgl1 \
    libglib2.0-0 \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# 配置 pip 国内镜像源（阿里云）
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com

# 先装 CPU 版 torch/torchvision（阿里云 pytorch-wheels 镜像）
# 目的：满足 mineru[core] 对 torch>=2.6,<3 的依赖，
# 避免 pip 从 PyPI 拉取自带 NVIDIA CUDA 全家桶（cudnn/cublas/nccl 约 3GB）导致镜像臃肿且下载易超时
RUN pip install --no-cache-dir --retries 10 --timeout 60 \
    torch==2.6.0+cpu torchvision==0.21.0+cpu \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    -f https://mirrors.aliyun.com/pytorch-wheels/cpu/

# 安装 MinerU（CPU 模式）
# 固定 2.x：api_server.py 依赖 mineru.cli.client.do_parse，
# 且 mineru-models-download 的 -m 参数在 4.x 已移除，请勿升级到 4.x
# --retries/--timeout：国内网络偶发读超时（ReadTimeoutError），失败重试兜底
RUN pip install --no-cache-dir --retries 10 --timeout 60 -U 'mineru[core]>=2.7,<3'

# 下载模型配置（使用 ModelScope 国内源）
RUN mineru-models-download -s modelscope -m all

# 安装 FastAPI + Uvicorn + MinIO 用于 API 服务
RUN pip install --no-cache-dir --retries 10 --timeout 60 fastapi "uvicorn[standard]" python-multipart minio

# 复制 API 服务脚本
COPY api_server.py /app/

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 设置环境变量并启动服务
ENV MINERU_MODEL_SOURCE=local \
    APP_ENV=production \
    UVICORN_WORKERS=1
CMD ["python", "api_server.py"]

